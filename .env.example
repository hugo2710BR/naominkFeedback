# Supabase (Project Settings > API). Usado apenas como base de dados
# Postgres para os metadados das fotos — as imagens vivem no Cloudflare R2.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (Dashboard > R2 > Manage API Tokens).
# Nunca uses o prefixo NEXT_PUBLIC_ nestas — são só para o servidor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=naomink-photos

# Domínio público ligado ao bucket R2. Duplicado com o prefixo
# NEXT_PUBLIC_ porque o browser monta os <img src> a partir dele.
R2_PUBLIC_URL=https://fotos.exemplo.pt
NEXT_PUBLIC_R2_PUBLIC_URL=https://fotos.exemplo.pt

# Guardar também a foto original sem compressão (só usada no ZIP do admin).
KEEP_ORIGINALS=true

# "auto": as fotos aparecem logo. "manual": precisam de aprovação em /admin.
MODERATION_MODE=auto

# Palavra-passe de acesso a /admin.
ADMIN_PASSWORD=change-me

# URL público do site (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
